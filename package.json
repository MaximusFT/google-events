{
  "name": "@maximusft/google-events",
  "description": "Declarative DOM events with inherited context, typed fields and pluggable analytics receivers",
  "private": false,
  "version": "0.3.0",
  "author": {
    "name": "MaximusFT"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximusFT/google-events.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "docs",
    "CHANGELOG.md",
    "examples/react",
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.js.map",
    "dist/index.cjs.map",
    "dist/index.d.ts",
    "dist/index.d.cts"
  ],
  "keywords": [
    "google",
    "google tag manager",
    "dataLayer",
    "analytic",
    "gtm",
    "google version 4",
    "declarative",
    "dom",
    "analytics",
    "data-attributes"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MaximusFT/google-events/issues"
  },
  "homepage": "https://github.com/MaximusFT/google-events#readme",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "rollup -c",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.examples.json",
    "test": "npm run build && node --test",
    "test:package": "node scripts/check-package.mjs",
    "test:browser": "playwright test",
    "test:site": "playwright test --config playwright.site.config.mjs",
    "check": "npm run typecheck && npm test && npm run test:package",
    "check:all": "npm run check && npm run test:browser",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rollup/plugin-commonjs": "^25.0.2",
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^27.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^3.26.2",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-dts": "^5.3.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.35.0",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  }
}
